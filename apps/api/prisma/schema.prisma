// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

// 2026 FIFA World Cup entrant, real data (Wikipedia, CC BY-SA 4.0).
model Team {
  id             Int    @id
  name           String
  // Real 2026 draw seeding pot (1-4) - see scripts/team-pot-data.ts.
  pot            Int
  // Real confederation code (UEFA/CONMEBOL/CONCACAF/CAF/AFC/OFC) - used by
  // the group-draw algorithm's "no two same-confederation teams per group"
  // constraint (UEFA exempted, 1-2 per group).
  confederation  String
  // Real FIFA Men's World Ranking position around the team's pot
  // assignment (lower = better) - see scripts/team-pot-data.ts. Finer-
  // grained than `pot`, so it can still separate two same-pot teams that
  // meet in a knockout round (buildStrengthMap in campaigns.service.ts).
  fifaRank       Int

  homeMatches     Match[]              @relation("HomeTeam")
  awayMatches     Match[]              @relation("AwayTeam")
  players         Player[]
  snapshots       MatchSnapshot[]
  tacticalProfile TeamTacticalProfile?
  campaigns       Campaign[]
}

// Real 2026 World Cup squad entry (Wikipedia, CC BY-SA 4.0). Each player
// belongs to exactly one team's roster - Wikipedia has no per-match lineup
// data, so there is no separate "squad for this match" concept anymore
// (see the old MatchSquad, removed).
model Player {
  id           Int    @id
  name         String
  teamId       Int
  team         Team   @relation(fields: [teamId], references: [id])
  jerseyNumber Int
  // Real broad position category from the Wikipedia squad table: GK/DF/MF/FW.
  position     String

  attributes PlayerAttributes?
}

// Constructed/mock FIFA-style ratings (1-99), NOT derived from real
// aggregate stats. Deterministically generated per player (seeded by
// playerId), base range picked from their real `position` group -
// explicitly allowed as "구성 데이터" per contest rules.
model PlayerAttributes {
  playerId  Int    @id
  player    Player @relation(fields: [playerId], references: [id])
  pace      Int
  shooting  Int
  passing   Int
  defending Int
  physical  Int
  stamina   Int
}

// Constructed/mock team playing-style parameters (0-100), seeded by
// teamId. Feeds the AI what-if generator's tactical reasoning and the
// lightweight background-match score simulator.
model TeamTacticalProfile {
  teamId            Int  @id
  team              Team @relation(fields: [teamId], references: [id])
  pressingIntensity Int
  possessionStyle   Int
  defensiveLine     Int
}

// A manager's run through the tournament with one team, identified by a
// nickname only (no password/auth - this is a hackathon demo, not a real
// account system).
model Manager {
  id        String     @id @default(cuid())
  nickname  String     @unique
  createdAt DateTime   @default(now())
  campaigns Campaign[]
}

model Campaign {
  id        String   @id @default(cuid())
  managerId String
  manager   Manager  @relation(fields: [managerId], references: [id])
  teamId    Int
  team      Team     @relation(fields: [teamId], references: [id])
  createdAt DateTime @default(now())
  matches   Match[]

  @@unique([managerId, teamId])
}

// A single tournament match, always owned by exactly one Campaign - the
// group draw and full schedule (group stage + knockout) are generated
// fresh per campaign (real FIFA pot/confederation constraints, but a
// random draw every time - see the group-draw service), not a shared
// real-world catalog. `played=false` means homeScore/awayScore are not
// yet meaningful (both default 0). Whether a played match was a
// win/draw/loss for a given team is computed on demand from the scores,
// never stored - a "for team X" result isn't a property of the match
// itself, since most matches don't involve the campaign's own team.
model Match {
  id               Int      @id @default(autoincrement())
  campaignId       String
  campaign         Campaign @relation(fields: [campaignId], references: [id])
  competitionStage String
  matchWeek        Int

  homeTeamId Int
  homeTeam   Team @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeamId Int
  awayTeam   Team @relation("AwayTeam", fields: [awayTeamId], references: [id])

  played    Boolean @default(false)
  homeScore Int     @default(0)
  awayScore Int     @default(0)

  snapshots  MatchSnapshot[]
  ballEvents MatchBallEvent[]

  @@index([campaignId, competitionStage])
}

// Chosen formation + starting XI for one team in one match, at a point in
// time (minute 0 = kickoff selection; a later minute = an in-match
// substitution/tactical shift the manager made). Always constructed (the
// manager's own choice, or the auto-assigned opponent lineup) - there is
// no real per-match lineup source anymore.
model MatchSnapshot {
  id        String   @id @default(cuid())
  matchId   Int
  match     Match    @relation(fields: [matchId], references: [id])
  teamId    Int
  team      Team     @relation(fields: [teamId], references: [id])
  minute    Int
  second    Int
  formation String
  // JSON array of 11 { playerId, name, jerseyNumber, positionId, positionName }
  lineup    String
  // Real wall-clock creation time (not match-clock minute/second) - lets
  // campaigns.service.ts's getPreviousLineup find "the kickoff lineup the
  // manager most recently submitted across this campaign" even though
  // matches don't carry a real calendar date to sort by otherwise.
  createdAt DateTime @default(now())

  @@index([matchId, teamId, minute, second])
}

// Ball-involved events (Pass/Carry/Shot/Corner/...) with pitch coordinates
// (0-120 x 0-80). For the campaign's own matches these are persisted as
// the AI what-if generator streams each chunk (so revisiting an
// in-progress match, live stats, and narration all read from the same
// rows); background matches (not involving the campaign's team) get no
// ball events at all, only a final score.
model MatchBallEvent {
  id            String  @id
  matchId       Int
  match         Match   @relation(fields: [matchId], references: [id])
  teamId        Int
  type          String
  period        Int
  minute        Int
  second        Int
  duration      Float
  playerId      Int?
  playerName    String?
  recipientId   Int?
  recipientName String?
  x             Float
  y             Float
  endX          Float?
  endY          Float?
  outcome       String?
  // The AI's own narration line for this moment (written live as part of
  // the what-if generation, not a template) - null for the single
  // synthetic kickoff anchor event, which is never shown in the log.
  commentary    String?

  @@index([matchId, minute, second])
}
